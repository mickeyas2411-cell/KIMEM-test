{
  "name": "kimem-staging-player-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check player-api-worker.js",
    "test": "node --test tests/*.test.js",
    "deploy": "wrangler deploy --config wrangler.staging.toml",
    "build": "esbuild player-api-worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/player-api-worker.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "esbuild": "^0.25.0"
  }
}
